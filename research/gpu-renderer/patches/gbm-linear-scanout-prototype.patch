+/// Copy the rendered pixels into the published GBM buffer. The prototype
+/// copies the whole frame; a real version would copy the damage accumulated
+/// since this buffer's previous commit.
+pub fn publish(self: *ShmBuffer) void {
+    const g = self.gbm orelse return;
+    const row_bytes = @as(usize, self.width) * 4;
+    for (0..self.height) |y| {
+        @memcpy(g.map[y * g.stride ..][0..row_bytes], self.data[y * row_bytes ..][0..row_bytes]);
+    }
+}
+
+fn createGbm(width: u31, height: u31) !Gbm {
+    if (gbm_device == null) {
+        const rc = linux.open("/dev/dri/renderD128", .{ .ACCMODE = .RDWR, .CLOEXEC = true }, 0);
+        if (linux.errno(rc) != .SUCCESS) return error.GbmUnavailable;
+        gbm_device = gbm_create_device(@intCast(rc)) orelse return error.GbmUnavailable;
+    }
+    const GBM_BO_USE_SCANOUT = 1 << 0;
+    const GBM_BO_USE_LINEAR = 1 << 4;
+    const bo = gbm_bo_create(gbm_device.?, width, height, 0x34325258, GBM_BO_USE_SCANOUT | GBM_BO_USE_LINEAR) orelse
+        return error.GbmAllocFailed;
+    errdefer gbm_bo_destroy(bo);
+    const fd = gbm_bo_get_fd(bo);
+    if (fd < 0) return error.GbmAllocFailed;
+    const stride = gbm_bo_get_stride(bo);
+    const map = try posix.mmap(null, @as(usize, stride) * height, .{ .READ = true, .WRITE = true }, .{ .TYPE = .SHARED }, fd, 0);
+    std.log.info("gbm buffer {d}x{d} stride {d} modifier 0x{x}", .{ width, height, stride, gbm_bo_get_modifier(bo) });
+    return .{ .bo = bo, .fd = fd, .stride = stride, .map = map };
+}
+
+fn destroyGbm(g: Gbm) void {
+    posix.munmap(g.map);
+    _ = linux.close(g.fd);
+    gbm_bo_destroy(g.bo);
+}
+
+fn gbmBuffer(g: Gbm, width: u31, height: u31, format: Format) !*wl.Buffer {
+    const params = try dmabuf.?.createParams();
+    defer params.destroy();
+    params.add(g.fd, 0, 0, g.stride, 0, 0); // DRM_FORMAT_MOD_LINEAR
+    std.debug.assert(format == .xrgb8888);
+    return params.createImmed(width, height, 0x34325258, .{});
+}
+
 fn createUdmabuf(memfd: posix.fd_t, size: usize) !posix.fd_t {
     if (udmabuf_dev < 0) {
         const rc = linux.open("/dev/udmabuf", .{ .ACCMODE = .RDWR, .CLOEXEC = true }, 0);
